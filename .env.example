# FamilyCentralAPI Environment Configuration
# Copy this file to .env and fill in values before running the app.

# Application
APP_NAME=FamilyCentralAPI
DEBUG=false
# Set true only for local development if you need /docs, /redoc, and /openapi.json.
EXPOSE_API_DOCS=false

# Database Configuration (SQLite - local file by default)
DATABASE_URL=sqlite+aiosqlite:///./family.db

# Security (required for protected /api/v1 endpoints)
FAMILY_API_KEY=your-super-secret-family-key-change-this

# CORS: comma-separated origins or JSON-style list supported by settings parser.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Provider modes. Use "mock" for safe local simulation.
PLN_CHECK_URL=mock
PDAM_CHECK_URL=mock
INDIHOME_CHECK_URL=mock

# Provider-specific API keys (reserved for custom integrations)
PLN_API_KEY=
PDAM_API_KEY=
INDIHOME_API_KEY=

# Sepulsa integration key. Keep empty for mock mode.
SEPULSA_API_KEY=

# HTTP Settings
HTTP_TIMEOUT=30.0
HTTP_MAX_RETRIES=3
