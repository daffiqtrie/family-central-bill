# FamilyCentralAPI Environment Configuration
# Copy this file to .env and fill in the values

# Database Configuration (SQLite - local file)
DATABASE_URL=sqlite+aiosqlite:///./family.db

# Security
FAMILY_API_KEY=your-super-secret-family-key-change-this

# Application
DEBUG=true
APP_NAME=FamilyCentralAPI

# HTTP Settings
HTTP_TIMEOUT=30.0
HTTP_MAX_RETRIES=3
